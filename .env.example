# =============================================================================
# Sahayak Environment Configuration Example
# =============================================================================

# Gemini API Key (Required for AI generation, RAG, letter explanation, and smart forms)
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Application Host URL
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
# Option 1: Full Connection String (Recommended for Docker, Supabase, Neon, Railway)
# For local Docker Compose (run "docker compose up -d"):
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/sahayak"

# For Supabase / Neon:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Option 2: Individual variables (Cloud SQL / manual Postgres)
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="sahayak"
SQL_USER="postgres"
SQL_PASSWORD="postgrespassword"
SQL_SSL="false"

NEXT_PUBLIC_SUPABASE_URL=https://rlnmstrjcnifcyacwnke.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_J1fn--93Ay1mdypQXpiDEg_KFT8b_FF
DATABASE_URL= postgresql://postgres.rlnmstrjcnifcyacwnke:OoKuDOC4bDfyq37U@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
supabase pwd: OoKuDOC4bDfyq37U

# Cloud SQL Admin Credentials (Optional - defaults to SQL_USER / SQL_PASSWORD)
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Secret HMAC key for signing Phone OTP & Guest session tokens
SESSION_SECRET="sahayak-development-session-secret-key-32b"

# -----------------------------------------------------------------------------
# Indic Language Services (Optional)
# -----------------------------------------------------------------------------
# Sarvam AI API subscription key for Indian language STT/TTS
# (Leave empty to use Gemini audio fallback)
SARVAM_API_KEY=""

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
STARTUP_TIMEOUT_MS="120000"

# Grounded chat generation model; separate from speech and embeddings.
QA_GEMINI_MODEL="gemini-3.1-flash-lite"
# ISL UI stays available for text fallback; live recognition requires a validated model.
VITE_ENABLE_ISL_ASSIST=false
