# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (Object Method)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""

# Cloud SQL Admin Variables for Drizzle Kit Schema Migrations
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional Session Signing Key for Phone OTP & Guest Sessions
SESSION_SECRET=""
