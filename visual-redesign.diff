+
+/* Theme-only overrides; existing component classes and selectors are preserved. */
+@layer base {
+ body { line-height:1.6; }
+ h1,h2,h3,h4,h5,h6 { font-family:'Fraunces',Georgia,serif; font-weight:700; line-height:1.15; }
+ p { max-inline-size:75ch; }
+ a { color:inherit; } a:hover { text-decoration:underline; }
+ :focus-visible { outline:3px solid currentColor; outline-offset:3px; }
+ input,textarea,select,table { background:var(--panel); color:var(--ink); border:2px solid var(--ink); border-radius:5px; }
+}
+[class*="shadow"] { box-shadow:none !important; text-shadow:none !important; }
+[class*="backdrop-blur"] { backdrop-filter:none !important; }
+[class*="bg-gradient"], [class*="bg-linear"] { background-image:none !important; }
+[class*="rounded"]:not(.rounded-full) { border-radius:5px; }
+.bg-card { border:2px solid var(--ink); }
+button.bg-primary,button.bg-voice { border:2px solid var(--red); }
+button.bg-primary:hover,button.bg-voice:hover { background:var(--green); border-color:var(--green); }
+button.bg-secondary { border:2px solid currentColor; background:transparent; }
+header { --text-body:var(--cream); --text-muted:var(--cream); --action-primary:var(--cream); --action-on-primary:var(--red); background:var(--hero) !important; color:var(--hero-ink); }
+aside,footer { --text-body:var(--cream); --text-muted:var(--cream); --surface-card:var(--band); --surface-elevated:var(--band); --surface-tint:var(--band); --text-tint-fg:var(--cream); --border-hairline:var(--cream); background:var(--band) !important; color:var(--band-ink); }
+.warli-logo { display:inline-block; vertical-align:middle; margin-inline-end:8px; flex-shrink:0; }
+header:has(.warli-strip) { padding-bottom:30px; height:auto; min-height:90px; }
+.warli-strip { position:absolute; bottom:0; inset-inline:0; width:100%; height:28px; color:var(--cream); pointer-events:none; }
+.warli-hut { width:100%; max-width:160px; height:94px; margin:16px auto; color:var(--cream); pointer-events:none; }
+@media(max-width:400px){ header { column-gap:6px !important; padding-inline:10px !important; } }
+@media(prefers-reduced-motion:reduce){ *,*::before,*::after { animation:none !important; transition:none !important; } }
+
+/* Preserve the existing palette controls while restricting their swatches. */
+[class*="bg-[#898AC4]"] { background-color:var(--red) !important; }
+[class*="bg-[#C1785A]"] { background-color:var(--green) !important; }
+header button.bg-primary { background:var(--cream); color:var(--red); }
+header button.bg-primary:hover { background:var(--green); color:var(--cream); }
+.text-danger { border-inline-start:3px double currentColor; padding-inline-start:8px; }
+
+/* Warli composition: a warm canvas in every system appearance. */
+:root,.dark { color-scheme:light; --bg:var(--cream); --ink:var(--red); --panel:var(--cream); --band:var(--green); }
+.onboarding { background:var(--cream); color:var(--red); --app-font-stack:'Mukta','Segoe UI',system-ui,sans-serif; font-family:var(--app-font-stack); }
+.onboarding button { font-size:16px; font-weight:600; min-height:44px; transition:color 150ms,background-color 150ms,border-color 150ms; }
+.onboarding h1 { letter-spacing:-.01em; }
+.onboarding-header { position:relative; border:0; }
+.onboarding-header > div:first-child { height:72px; max-width:1148px; }
+.onboarding-header > div:first-child > span { display:flex; align-items:center; font-family:'Fraunces',Georgia,serif; font-size:26px; }
+.warli-person { width:24px; height:36px; flex-shrink:0; pointer-events:none; }
+.onboarding-header span > .warli-person { margin-inline-end:12px; }
+.warli-figure-row { display:flex; justify-content:space-around; gap:16px; overflow:hidden; pointer-events:none; }
+.warli-figure-row .warli-person:nth-child(even) { transform:scaleX(-1); }
+.onboarding-header > .warli-figure-row { height:10px; color:var(--cream); }
+.onboarding-header > .warli-figure-row .warli-person { width:12px; height:18px; }
+.language-main { max-width:none; padding:0 0 64px; margin:0; }
+.language-main > * { margin-block-start:32px; }
+.language-main > :not(.language-hero) { width:calc(100% - 64px); max-width:1100px; margin-inline:auto; }
+.language-main .language-hero { position:relative; isolation:isolate; background:var(--green); color:var(--cream); max-width:none; min-height:248px; margin:0; padding:56px max(32px,calc((100% - 1100px)/2)); display:flex; flex-direction:column; justify-content:center; }
+.language-hero h1 { color:var(--cream); font-size:clamp(2.2rem,4vw,3.4rem); max-width:calc(100% - 430px); }
+.language-hero p { color:var(--cream); font-size:20px; max-width:calc(100% - 430px); margin-top:16px; }
+.warli-scene { pointer-events:none; }
+.language-hero > .warli-scene { position:absolute; inset-inline-end:max(32px,calc((100% - 1100px)/2)); width:390px; height:200px; }
+.language-main .language-suggestion { position:relative; margin-top:48px; padding:32px; border:2px solid var(--red); border-radius:8px; background:var(--cream); }
+.language-suggestion > div:first-child > p:first-of-type { background:var(--red); color:var(--cream); display:table; padding:4px 12px; margin-top:-46px; margin-bottom:16px; font-size:14px; }
+.language-suggestion > div:first-child > p:last-child { color:var(--red); font-size:26px; }
+.language-suggestion p span { color:var(--green); font-size:17px; }
+.language-suggestion > div > .warli-person { position:absolute; inset-inline-end:16px; top:-28px; background:var(--cream); }
+.language-suggestion button { border:2px solid var(--red); border-radius:8px; }
+.language-main .language-search { max-width:560px; margin-inline-start:max(32px,calc((100% - 1100px)/2)); }
+.onboarding input { background:var(--cream); color:var(--red); border:2px solid var(--red); border-radius:8px; min-height:52px; }
+.onboarding input:focus { border-color:var(--green); }
+.onboarding input::placeholder { color:var(--red); opacity:.6; }
+.language-search > svg { color:var(--red); top:16px; }
+.language-main .language-divider { max-width:320px; color:var(--red); margin-block:32px; }
+.language-divider .warli-person { width:16px; height:24px; }
+.language-main .language-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:16px; }
+.language-card { position:relative; background:var(--cream); color:var(--red); border:2px solid var(--red); border-radius:8px !important; padding:20px; min-height:126px; transition:background-color 150ms,color 150ms; }
+.language-card > button:first-child > div > span { font-size:22px; }
+.language-card > button:first-child > span { font-family:'Fraunces',Georgia,serif; font-size:16px; color:var(--green); }
+.language-card > button:last-child:not(:first-child) { background:transparent; color:inherit; border:2px solid currentColor; border-radius:8px; padding-inline:10px; }
+.language-card:hover { background:var(--green); color:var(--cream); outline:2px solid var(--cream); outline-offset:-6px; }
+.language-card:has(.border-strong),.language-card.border-strong { background:var(--red); color:var(--cream); border-color:var(--red); }
+.language-card:hover > button > span,.language-card.border-strong > button > span { color:var(--cream); }
+.language-card-figure { display:none; position:absolute; bottom:6px; inset-inline-end:8px; pointer-events:none; }
+.language-card.border-strong .language-card-figure { display:block; }
+.language-card-figure .warli-person { width:12px; height:18px; }
+.onboarding-footer { background:var(--green); color:var(--cream); padding:16px 32px 24px; }
+.onboarding-footer > div:last-child { max-width:1100px; margin:auto; display:flex; align-items:center; justify-content:space-between; gap:24px; }
+.onboarding-footer p { font-size:17px; max-width:70ch; }
+.onboarding-footer .warli-scene { width:180px; height:90px; flex-shrink:0; }
+.onboarding :focus-visible { outline:3px solid currentColor; outline-offset:3px; }
+@media(max-width:799px){ .language-hero > .warli-scene { display:none; } .language-hero h1,.language-hero p { max-width:100%; } .language-main .language-hero { padding:40px 24px; min-height:220px; } }
+@media(max-width:599px){ .language-main > :not(.language-hero) { width:calc(100% - 32px); } .language-main .language-search { margin-inline:16px; } .language-main .language-grid { grid-template-columns:1fr; } .language-main .language-suggestion { padding:24px; margin-top:40px; } .language-suggestion > div:first-child > p:first-of-type { margin-top:-38px; } .onboarding-footer { padding-inline:16px; } .onboarding-footer .warli-scene { width:100px; } }
+@media(prefers-reduced-motion:reduce){ .onboarding * { transition:none !important; animation:none !important; } }
+
+.onboarding-header button { background:var(--cream); color:var(--red); border:2px solid var(--cream); }
+.onboarding-header button:hover { background:var(--green); color:var(--cream); }
+.onboarding-header button * { color:inherit; }
+.language-suggestion button:not(.bg-primary):hover { background:var(--green); color:var(--cream); border-color:var(--green); }
+.language-card > button:hover { color:inherit; }
+.language-card.border-strong { --text-body:var(--cream); --text-muted:var(--cream); --text-tint-fg:var(--cream); }
+.language-card:hover { --text-body:var(--cream); --text-muted:var(--cream); }
+.onboarding-footer > .warli-figure-row { border-bottom:2px solid currentColor; padding-bottom:8px; margin-bottom:16px; }
