+.onboarding-header button:hover { background:var(--brown); color:var(--cream); }
+.onboarding-header button * { color:inherit; }
+.language-suggestion button:not(.bg-primary):hover { background:var(--brown); color:var(--cream); border-color:var(--brown); }
+.language-card > button:hover { color:inherit; }
+.language-card.border-strong { --text-body:var(--cream); --text-muted:var(--cream); --text-tint-fg:var(--cream); }
+.language-card:hover { --text-body:var(--cream); --text-muted:var(--cream); }
+
+/* Two-color surface system. Existing semantic utility names remain compatible. */
+@theme { --color-brown:var(--brown); --color-white:var(--white); }
+:root,.dark { --bg:var(--white); --panel:var(--white); --ink:var(--brown); --band:var(--brown); color-scheme:light; }
+body,.surface-light { background:var(--white); color:var(--brown); }
+.surface-brown,header,aside,footer { background:var(--brown); color:var(--white); --text-body:var(--white); --text-muted:var(--white); --text-tint-fg:var(--white); --border-hairline:currentColor; --border-strong:currentColor; }
+.surface-brown :where(a,span,p,h1,h2,h3,h4,label,svg),header :where(a,span,p,svg),aside :where(a,span,p,svg),footer :where(a,span,p,svg) { color:inherit; }
+.surface-brown :where(button,input,textarea,select),header :where(button,input,select),aside :where(button,input,select) { background:var(--white); color:var(--brown); border:2px solid currentColor; }
+.surface-brown :where(button):hover,header button:hover,aside button:hover { background:var(--brown); color:var(--white); }
+.surface-brown button *,header button *,aside button * { color:inherit; }
+svg.lucide { stroke:currentColor; stroke-width:2px; fill:none; }
+a { color:inherit; text-decoration:underline; text-underline-offset:3px; }
+::selection { background:var(--brown); color:var(--white); }
+* { scrollbar-color:var(--brown) var(--white); }
+*::-webkit-scrollbar-thumb { background:var(--brown); border:2px solid var(--white); }
+*::-webkit-scrollbar-track { background:var(--white); }
+input,textarea,select,.surface-brown input,.surface-brown textarea,.surface-brown select { background:var(--white); color:var(--brown); border:2px solid var(--brown); caret-color:var(--brown); accent-color:var(--brown); }
+input::placeholder,textarea::placeholder { color:var(--brown); opacity:.6; }
+input:focus-visible,textarea:focus-visible,select:focus-visible { outline:3px solid var(--brown); outline-offset:3px; }
+:focus-visible { outline:3px solid currentColor; outline-offset:3px; }
+button { min-height:44px; font-weight:600; }
+button:disabled { opacity:.6; }
+button.bg-primary,button.bg-voice { background:var(--brown); color:var(--white); border:2px solid var(--brown); }
+button.bg-primary:hover,button.bg-voice:hover { background:var(--white); color:var(--brown); }
+button.bg-primary *,button.bg-voice * { color:inherit; }
+.onboarding-header { height:72px; }
+.onboarding-header::after { content:""; position:absolute; bottom:0; inset-inline:24px; border-bottom:2px solid var(--white); }
+.language-main .language-hero { min-height:232px; padding-block:64px; background:var(--brown); color:var(--white); }
+.language-hero h1,.language-hero p { max-width:70ch; color:inherit; }
+.language-main .language-suggestion { padding:24px; }
+.language-suggestion > div:first-child > p:first-of-type { margin-top:-38px; }
+.language-suggestion button.bg-primary { background:var(--brown); color:var(--white); }
+.language-suggestion button.bg-primary:hover { background:var(--white); color:var(--brown); }
+.language-suggestion p span { color:var(--brown); font-weight:400; }
+.language-main .language-divider,.language-card-figure { display:none; }
+.language-card { background:var(--white); color:var(--brown); }
+.language-card > button:first-child > span { color:inherit; }
+.language-card:hover { background:var(--brown); color:var(--white); outline:none; }
+.language-card.border-strong { background:var(--brown); color:var(--white); outline:2px solid var(--white); outline-offset:-6px; }
+.language-card button,.language-card button:hover,.language-card span,.language-card svg { color:inherit; }
+.language-card.border-strong:hover { background:var(--white); color:var(--brown); outline-color:var(--brown); }
+.language-card.border-strong:hover > button > span { color:inherit; }
+.onboarding-footer { background:var(--brown); color:var(--white); position:relative; padding:32px; margin-top:64px; }
+.onboarding-footer::before { content:""; position:absolute; top:16px; inset-inline:24px; border-top:2px solid var(--white); }
+.language-main::after { content:""; display:block; max-width:1100px; margin:64px auto 0; width:calc(100% - 32px); border-top:2px solid var(--brown); }
+[class*="shadow"] { box-shadow:none !important; text-shadow:none !important; }
+[class*="bg-gradient"],[class*="bg-linear"] { background-image:none !important; }
+.text-danger { font-weight:600; border-inline-start:3px double currentColor; }
+@media(max-width:799px){ .language-main .language-hero { padding-block:40px; min-height:200px; } }
+@media(prefers-reduced-motion:reduce){ *,*::before,*::after { animation:none !important; transition:none !important; } }
+
+header button.bg-primary { border-color:var(--white); background:var(--white); color:var(--brown); }
+header button.bg-primary:hover { background:var(--brown); color:var(--white); }
+.language-hero h1,.language-hero p { max-width:70ch; }
+.language-card.border-strong .language-card-figure { display:none; }
+
+* { --tw-ring-offset-color:var(--white); --tw-shadow-color:transparent; --tw-inset-shadow-color:transparent; }
