+.onboarding input { background:var(--cream); color:var(--red); border:2px solid var(--red); border-radius:8px; min-height:52px; }
+.onboarding input:focus { border-color:var(--brown); }
+.onboarding input::placeholder { color:var(--red); opacity:.6; }
